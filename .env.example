# TIKI Universal IDE environment
# Copy values into your shell environment. The server does not auto-load .env.

# --- Core ---
TIKI_HOST=127.0.0.1
TIKI_PORT=4317
TIKI_WORKSPACE=/absolute/path/to/your/project
TIKI_CONFIG_DIR=/absolute/path/to/config
# Data dir for runs/events/usage ledger (default: <config>/data)
# TIKI_DATA_DIR=/absolute/path/to/data
TIKI_LOG_LEVEL=info

# --- Remote mode (disabled by default; loopback only) ---
# Enables binding to non-loopback hosts. Requires a token.
TIKI_ALLOW_REMOTE=0
TIKI_AUTH_TOKEN=change-me-to-a-long-random-string

# --- OpenCode native adapter ---
OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_BIN=opencode

# --- Hermes (OpenAI-compatible) ---
HERMES_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# --- OpenClaw (OpenAI-compatible) ---
OPENCLAW_URL=http://127.0.0.1:18789/v1
OPENCLAW_API_KEY=
OPENCLAW_MODEL=openclaw/default

# --- Tools ---
# Comma-separated host allowlist for the generic HTTP tool. Empty = deny all.
TIKI_TOOL_HTTP_ALLOWLIST=

# --- Cost engine ---
# Optional default currency for display
TIKI_CURRENCY=USD
